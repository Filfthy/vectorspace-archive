  "presentationPacks": [
    {
      "presentationId": "station_delivery",
      "faction": "free_traders",
      "board": {
        "titles": [
          "Relay Consignment",
          "Priority Freight",
          "Contract Delivery"
        ],
        "descriptions": [
          "Deliver {cargo} to {destination}. Standard handling terms apply.",
          "Carry a sealed freight consignment from {origin} to {destination}."
        ]
      },
      "routineComplete": {
        "subjects": [
          "CONSIGNMENT DELIVERED"
        ],
        "bodies": [
