      "personalFollowUps": [
        {
          "trigger": "major_encounter",
          "chance": 0.55,
          "contact": "corvella_pallis",
          "subjects": [
            "THAT APPROACH"
          ],
          "bodies": [
            "Babe, I saw the approach report. You still got the parcel onto the pad. That's fronking lovely work. I've added something extra."
          ]
        }
      ]
    },
    {
      "presentationId": "station_delivery",
      "faction": "quickbite",
      "board": {
        "titles": [
          "Priority Order",
          "Hot Run",
          "Relay Delivery"
        ],
        "descriptions": [
          "Get {cargo} to {destination}. Customer has already paid.",
          "Take the order to {destination}. Yes, it is still supposed to be hot."
        ]
      },
      "routineComplete": {
        "subjects": [
          "ORDER DELIVERED"
        ],
        "bodies": [
          "Order accepted at {destination}. Payment of {credits} credits released."
        ]
      },
      "personalFollowUps": [
        {
          "trigger": "major_encounter",
          "chance": 0.55,
          "contact": "nyxo_malloc",
          "subjects": [
            "DUDE"
          ],
          "bodies": [
            "Dude. Xenos on the approach and you still got the order there. Awesome."
          ]
        }
      ]
    },
    {
      "presentationId": "xeno_nest_recovery",
      "faction": "helix",
      "board": {
        "titles": [
          "Xeno Specimen Recovery",
