        {
          "trigger": "valuable_recovery",
          "chance": 0.65,
          "contact": "navira_derris",
          "subjects": [
            "SPECIMEN"
          ],
          "bodies": [
            "Specimen integrity is exceptional. Please do not ask what it is worth."
          ]
        }
      ]
    },
    {
      "presentationId": "xeno_nest_recovery",
      "faction": "red_jackal",
      "board": {
        "titles": [
          "Treasure in the Hive",
          "Private Recovery"
        ],
        "descriptions": [
          "Something of ours has found its way into a xeno nest. The xenos have no title to it. Retrieve it."
        ]
      },
      "routineComplete": {
        "subjects": [
          "PROPERTY RECOVERED"
        ],
        "bodies": [
          "Recovered property has been received. Agreed payment of {credits} credits released."
        ]
      },
      "personalFollowUps": [
        {
          "trigger": "valuable_recovery",
          "chance": 0.65,
          "contact": "cassian_erivan_snade",
          "subjects": [
            "ORPHEUS"
          ],
          "bodies": [
            "Orpheus descended for Eurydice. You descended for a box. Happily, the box was considerably more valuable."
          ]
        }
      ]
